import { Theme, Ui } from "../theme.slint";
import { Metrics } from "metrics.slint";

export component RowButton inherits Rectangle {
    in property <string> text;
    in property <bool> outlined;
    in property <bool> enabled: true;
    in property <bool> focused;
    callback clicked();

    property <bool> lit: touch.has-hover || touch.pressed || root.focused;

    width: max(120px, label.preferred-width + 32px);
    height: 36px;
    border-radius: 4px;
    opacity: root.enabled ? 1 : 0.45;
    background: root.outlined ? (root.lit ? Theme.primary.with-alpha(0.08) : transparent) : Theme.primary;
    border-width: root.outlined ? 1px : 0;
    border-color: Theme.primary.with-alpha(0.5);
    drop-shadow-blur: !root.outlined && root.lit ? 16px : 0;
    drop-shadow-color: Theme.highlight.with-alpha(0.55);
    Rectangle {
        border-radius: 4px;
        border-width: root.lit ? 2px : 0;
        border-color: Theme.highlight.with-alpha(root.focused ? 0.85 : 0.65);
    }
    label := Text {
        text: root.text;
        font-size: 14px;
        font-weight: 500;
        letter-spacing: 0.4px;
        color: root.outlined ? Theme.primary : #000000de;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

export component ToolButton inherits Rectangle {
    in property <image> icon;
    in property <color> tint: Theme.text;
    in property <bool> enabled: true;
    in property <bool> focused;
    callback clicked();

    property <length> glyph: Metrics.icon-px + 4px;

    property <length> pad: Ui.width < 600px ? 4px : 12px;
    width: glyph + pad;
    height: glyph + pad;
    border-radius: self.width / 2;
    opacity: root.enabled ? 1 : 0.38;
    background: root.focused || (touch.has-hover && root.enabled) ? Theme.text.with-alpha(0.08) : transparent;
    border-width: root.focused ? 2px : 0;
    border-color: Theme.primary;
    Image {
        width: root.glyph;
        height: root.glyph;
        source: root.icon;
        colorize: root.tint;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

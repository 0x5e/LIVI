#!/bin/sh
# LIVI-Link boot, the same on every board: NCM+DHCP+mDNS, WiFi AP, HTTP, tinyshell, LEDs, MFi, BT.
# What differs per board (early setup, WiFi power and driver, the MFi bus) is in /etc/livi/board.sh.
mkdir -p /tmp/livi /tmp/livi/led
exec >/tmp/livi/rcS.log 2>&1
echo '[livi] rcS'
. /etc/livi/board.sh

# Restore persistent config from the customer partition into tmpfs
/usr/bin/livid config load 2>&1 | tail -3

board_early

hostname livi-link
ifconfig lo up
# usb0 (host) and wlan0 (phones) share one L2 segment: the phone reaches the host directly
# and mDNS crosses over. hostapd attaches wlan0 itself (bridge=br0 in hostapd.conf).
brctl addbr br0
brctl stp br0 off 2>/dev/null
brctl setfd br0 0 2>/dev/null
ifconfig usb0 up 2>/dev/null
brctl addif br0 usb0
ifconfig br0 10.10.10.1 netmask 255.255.255.0 mtu 1500 up
echo '[livi] br0 10.10.10.1/24 up (usb0 attached)'

/usr/bin/livi-netd br0 10.10.10.1 100 199 livi-link >/tmp/livi/netd.log 2>&1 &
echo "[livi] netd/br0 pid=$!"
/usr/bin/livi-httpd >/tmp/livi/httpd.log 2>&1 &
echo "[livi] httpd pid=$! :80"
/usr/bin/livi-tinyshell 2323 >/tmp/livi/tinyshell.log 2>&1 &
echo "[livi] tinyshell pid=$! :2323"

/usr/bin/livi-ledd >/tmp/livi/ledd.log 2>&1 &
echo "[livi] ledd pid=$!"

# MFi coprocessor bridge. Retries in the background until the board's I2C node is there.
if [ -n "$MFI_I2C" ]; then
    (
        for i in $(seq 1 20); do
            if [ -c /dev/i2c-$MFI_I2C ]; then
                /usr/bin/livi-mfid $MFI_I2C >/tmp/livi/mfid.log 2>&1 &
                echo "[livi] mfid pid=$! :5000 (i2c-$MFI_I2C)"
                break
            fi
            sleep 0.5
        done
    ) &
fi

# A telnetd of the initramfs does not survive the switch_root, so this one serves :23.
killall telnetd 2>/dev/null
telnetd -l /bin/sh -p 23 && echo "[livi] telnetd :23"

# The ways in are up: clear the mark the initramfs set for this boot, the next one takes this rootfs again.
for n in /sys/class/mtd/mtd[0-9]*; do
    [ "$(cat $n/name 2>/dev/null)" = bootstate ] && flash_eraseall -q /dev/mtd${n##*mtd} \
        && echo '[livi] bootstate cleared'
done

board_wifi
for i in $(seq 1 20); do
    [ -e /sys/class/net/wlan0 ] && break
    sleep 0.5
done
if [ -e /sys/class/net/wlan0 ]; then
    echo '[livi] wlan0 present'
    ifconfig wlan0 up
    # Seed the tmpfs hostapd base from the read-only default (livid config
    # load will overwrite it if a persisted copy is on the customer partition).
    [ -f /tmp/livi/hostapd.conf.saved ] || cp /etc/hostapd.conf /tmp/livi/hostapd.conf.saved
    /usr/bin/livi-wifid >/tmp/livi/wifid.log 2>&1 &
    echo "[livi] wifid pid=$! :5001"
    # Bring the AP up via wifid (goes through the same path a host would).
    sleep 0.3
    (echo on; sleep 0.05; echo save) | nc 127.0.0.1 5001 >/dev/null 2>&1 || \
        hostapd -B /tmp/livi/hostapd.conf.saved >/tmp/livi/hostapd.log 2>&1
    (
        for i in $(seq 1 30); do
            if [ "$(cat /sys/class/net/wlan0/operstate 2>/dev/null)" = "up" ] \
               && pidof hostapd >/dev/null; then
                touch /tmp/livi/led/ap-up
                echo '[livi] AP up (led signal set)'
                break
            fi
            sleep 0.5
        done
    ) &
else
    echo '[livi] wlan0 did not appear within 10s'
fi

# btd and iapd need hci0 up. Retries in the background until livi-bt-up gets the controller up, a
# driver can register hci0 before its controller answers.
(
    for i in $(seq 1 20); do
        if /usr/bin/livi-bt-up 0 2>&1 && [ -e /sys/class/bluetooth/hci0 ]; then
            touch /tmp/livi/led/bt-ready
            echo "[livi] bt-up ok on attempt $i"
            /usr/bin/livi-btd >/tmp/livi/btd.log 2>&1 &
            BTD_PID=$!
            /usr/bin/livi-iapd >/tmp/livi/iapd.log 2>&1 &
            IAPD_PID=$!
            echo "[livi] btd  pid=$BTD_PID  :5002"
            echo "[livi] iapd pid=$IAPD_PID :5004/:5005"
            break
        fi
        sleep 0.5
    done
    [ -e /tmp/livi/led/bt-ready ] || echo '[livi] bt-up gave up, no btd/iapd'
) &

(while :; do
    echo "$(cut -d. -f1 /proc/uptime)s" > /tmp/livi/heartbeat
    sleep 3
done) &
echo "[livi] heartbeat pid=$!"

echo 4 > /proc/sys/kernel/printk
echo '[livi] rcS done'

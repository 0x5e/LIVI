import { Theme } from "theme.slint";
import { ViewAreaMask, MaskData } from "mask.slint";

export struct CapData {
    path: string,
    opacity: float,
}

export struct TrailData {
    path: string,
    index: int,
}

export struct LabelData {
    x: float,
    y: float,
    text: string,
}

export struct GaugeData {
    box-w: float,
    box-h: float,
    minor: string,
    major: string,
    red-minor: string,
    red-major: string,
    caps: [CapData],
    trail: [TrailData],
    labels: [LabelData],
    label-size: float,
    cx: float,
    cy: float,
    radius: float,
    gap: float,
    mirror: bool,
    fit: float,
    tick-w: float,
    tick-h: float,
    major-h: float,
    ticks: int,
    redline-index: float,
    shadow: image,
    shadow-half: float,
}

export global DashState {
    in property <bool> enabled;
    in property <bool> gauges: true;
    in property <bool> map;
    in property <MaskData> mask;
    in property <int> center;
    in property <GaugeData> speed-gauge;
    in property <GaugeData> rpm-gauge;
    in property <float> speed-t;
    in property <float> rpm-t;
    in property <float> ring-shift;
    in property <string> speed-text: "0";
    in property <string> speed-label: "KPH";
    in property <string> gear: "P";
    in property <bool> turn-left;
    in property <bool> turn-right;
    in property <bool> hazards;
    in property <bool> lights;
    in property <bool> high-beam;
    in property <bool> parking-brake;
    in property <string> ambient;
    in property <int> fuel;
    in property <bool> fuel-low;
    in property <bool> battery;
    in property <string> oil-text: "0°";
    in property <float> oil-ratio;
    in property <bool> oil-hot;
    in property <color> accent;
    in property <bool> has-accent;
    in property <int> page-count;
    in property <int> page-index;
    in-out property <bool> dots-shown: true;
    in property <string> clock;
    in property <bool> nav-active;
    in property <image> nav-icon;
    in property <bool> nav-has-image;
    in property <image> nav-image;
    in property <int> nav-exit;
    in property <string> nav-distance;
    in property <string> nav-maneuver;
    in property <string> nav-road;
    in property <string> nav-after-road;
    in property <string> nav-time-left;
    in property <string> nav-destination-distance;
    in property <string> nav-destination;
    in property <string> nav-app;
    in property <string> placeholder: "No dashboard on this screen";
    callback select-page(int);
    callback step(int);
}

global Blink {
    in-out property <bool> on: true;
}

global Signal {
    out property <color> green: #19e04b;
    out property <color> blue: #2b8cff;
    out property <color> red: #ff3b30;
    out property <color> warn: #f44336;
    out property <color> amber: #ffa726;
}

component Gauge inherits Rectangle {
    in property <GaugeData> g;
    in property <float> value-t;
    in property <length> u;
    in property <color> scale-color;
    in property <color> major-color;
    in property <color> pointer-color;
    in property <color> needle-color: Theme.text;
    in property <bool> backdrop;
    in property <color> backdrop-color;

    property <bool> started;
    property <float> t: started ? value-t : -0.08;
    property <float> op: started ? 1 : 0;
    animate t { duration: 420ms; easing: ease-out; }
    animate op { duration: 700ms; easing: ease-out; }
    Timer {
        interval: 50ms;
        running: !root.started;
        triggered => { root.started = true; }
    }

    width: g.box-w * u;
    height: g.box-h * u;

    property <float> pointer-idx: t * (g.ticks - 1);
    property <angle> a: (g.gap / 2 + t * (360 - g.gap)) * 1deg;
    property <float> nx: g.radius * cos(a);
    property <float> ny: g.radius * sin(a);
    property <float> px: g.cx + (g.mirror ? -nx : nx);
    property <float> py: g.cy + ny;
    property <angle> pang: g.mirror ? 180deg - a : a;
    property <float> nh: g.major-h + 12 * g.fit;
    property <float> shift: (nh - g.tick-h) / 2;
    property <float> nxc: px - cos(pang) * shift;
    property <float> nyc: py - sin(pang) * shift;
    property <angle> th: pang + 90deg;
    property <float> hw: (g.tick-w + g.fit) / 2;
    property <float> hl: nh / 2;

    if root.backdrop: Image {
        x: (g.cx - g.shadow-half) * u;
        y: (g.cy - g.shadow-half) * u;
        width: g.shadow-half * 2 * u;
        height: g.shadow-half * 2 * u;
        source: g.shadow;
        colorize: root.backdrop-color;
        image-rendering: smooth;
    }

    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: g.box-w;
        viewbox-height: g.box-h;
        commands: g.minor;
        fill: root.scale-color;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: g.box-w;
        viewbox-height: g.box-h;
        commands: g.major;
        fill: root.major-color;
    }
    if g.red-minor != "": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: g.box-w;
        viewbox-height: g.box-h;
        commands: g.red-minor;
        fill: Signal.warn;
        opacity: 0.55;
    }
    if g.red-major != "": Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: g.box-w;
        viewbox-height: g.box-h;
        commands: g.red-major;
        fill: Signal.warn;
    }
    for c in g.caps: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: g.box-w;
        viewbox-height: g.box-h;
        commands: c.path;
        fill: root.scale-color;
        opacity: c.opacity;
    }
    for tr in g.trail: Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: g.box-w;
        viewbox-height: g.box-h;
        commands: tr.path;
        fill: tr.index >= g.redline-index ? Signal.warn : root.pointer-color;
        opacity: root.pointer-idx > 0 && tr.index <= root.pointer-idx ? root.op * 0.5 * tr.index / root.pointer-idx : 0;
    }
    Path {
        width: parent.width;
        height: parent.height;
        viewbox-width: g.box-w;
        viewbox-height: g.box-h;
        fill: root.t * (g.ticks - 1) >= g.redline-index ? Signal.warn : root.needle-color;
        opacity: root.op;
        MoveTo {
            x: root.nxc + (-root.hw) * cos(root.th) - (-root.hl) * sin(root.th);
            y: root.nyc + (-root.hw) * sin(root.th) + (-root.hl) * cos(root.th);
        }
        LineTo {
            x: root.nxc + root.hw * cos(root.th) - (-root.hl) * sin(root.th);
            y: root.nyc + root.hw * sin(root.th) + (-root.hl) * cos(root.th);
        }
        LineTo {
            x: root.nxc + root.hw * cos(root.th) - root.hl * sin(root.th);
            y: root.nyc + root.hw * sin(root.th) + root.hl * cos(root.th);
        }
        LineTo {
            x: root.nxc + (-root.hw) * cos(root.th) - root.hl * sin(root.th);
            y: root.nyc + (-root.hw) * sin(root.th) + root.hl * cos(root.th);
        }
        Close {}
    }
    for l in g.labels: Text {
        x: l.x * root.u - self.width / 2;
        y: l.y * root.u - self.height / 2;
        text: l.text;
        color: root.major-color;
        font-size: g.label-size * root.u;
    }
}

component Readout inherits Rectangle {
    in property <string> value;
    in property <string> caption;
    in property <bool> to-end;
    in property <length> u;
    in property <bool> backdrop;
    in property <color> backdrop-color;

    pure function snap(l: length) -> length { return round(l / 1phx) * 1phx; }

    property <length> value-w: snap(3 * 0.56 * 96 * u);
    property <length> pad-x: snap(18 * u);
    property <length> pad-y: snap(10 * u);
    property <length> gap: snap(2 * u);
    property <length> big-h: snap(big.preferred-height);
    property <length> small-h: snap(small.preferred-height);
    Rectangle {
        width: root.value-w + 2 * root.pad-x;
        height: root.big-h + root.gap + root.small-h + 2 * root.pad-y;
        x: root.snap((parent.width - self.width) / 2);
        y: root.snap((parent.height - self.height) / 2);
        border-radius: 16 * root.u;
        background: root.backdrop ? root.backdrop-color : transparent;
        big := Text {
            x: root.pad-x;
            y: root.pad-y;
            width: root.value-w;
            text: root.value;
            font-size: root.snap(96 * root.u);
            color: Theme.text;
            horizontal-alignment: root.to-end ? right : left;
        }
        small := Text {
            x: root.pad-x;
            y: root.pad-y + root.big-h + root.gap;
            width: root.value-w;
            text: root.caption;
            font-size: root.snap(10 * root.u);
            font-weight: 500;
            letter-spacing: 1.5 * root.u;
            color: Theme.text-secondary.with-alpha(0.5);
            horizontal-alignment: root.to-end ? right : left;
        }
    }
}

component Lamp inherits Image {
    in property <bool> active;
    in property <bool> blink;
    in property <color> tint;
    colorize: root.tint;
    opacity: root.active && (!root.blink || Blink.on) ? 1 : 0;
}

component SegmentBar inherits HorizontalLayout {
    in property <float> ratio;
    in property <color> on-color;
    in property <length> u;
    property <int> filled: round(clamp(ratio, 0, 1) * 8);
    spacing: 4 * u;
    alignment: center;
    for i in 8: Rectangle {
        width: 12 * root.u;
        height: 8 * root.u;
        y: (parent.height - self.height) / 2;
        border-radius: 2 * root.u;
        background: i < root.filled ? root.on-color : Theme.text-disabled;
        opacity: i < root.filled ? 1 : 0.5;
    }
}

component Level inherits Rectangle {
    in property <image> icon;
    in property <float> ratio;
    in property <string> value;
    in property <bool> warn;
    in property <length> u;
    width: row.preferred-width;
    row := HorizontalLayout {
    spacing: 9 * root.u;
    alignment: center;
    Image {
        width: 22 * root.u;
        height: 22 * root.u;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: root.warn ? Signal.warn : Theme.text-secondary;
    }
    SegmentBar {
        u: root.u;
        ratio: root.ratio;
        on-color: root.warn ? Signal.warn : Theme.text;
    }
    Text {
        min-width: 3 * 0.6 * 22 * root.u;
        text: root.value;
        font-size: 22 * root.u;
        color: root.warn ? Signal.warn : Theme.text;
        horizontal-alignment: right;
        vertical-alignment: center;
    }
    }
}

component Clock inherits Text {
    in property <length> u;
    text: DashState.clock;
    font-size: 44 * u;
    color: Theme.text;
    opacity: 0.55;
    letter-spacing: 1.9 * u;
    horizontal-alignment: center;
    vertical-alignment: center;
}

component Maneuver inherits Rectangle {
    in property <length> size;
    width: size;
    height: size;
    if DashState.nav-has-image: Image {
        width: parent.width;
        height: parent.height;
        source: DashState.nav-image;
        image-fit: contain;
    }
    if !DashState.nav-has-image: Image {
        width: parent.width;
        height: parent.height;
        source: DashState.nav-icon;
        colorize: Theme.text;
    }
    if !DashState.nav-has-image && DashState.nav-exit > 0: Rectangle {
        x: parent.width - self.width + 6px;
        y: parent.height - self.height + 6px;
        width: max(20px, exit.preferred-width + 12px);
        height: 20px;
        border-radius: 10px;
        background: Theme.button-active;
        exit := Text {
            text: DashState.nav-exit;
            font-size: 12px;
            color: Theme.text;
        }
    }
}

component Fact inherits HorizontalLayout {
    in property <image> icon;
    in property <string> text;
    in property <length> u;
    in property <float> size: 18;
    in property <float> dim: 1;
    spacing: 8 * u;
    Image {
        width: root.size * 1.1 * root.u;
        height: root.size * 1.1 * root.u;
        y: (parent.height - self.height) / 2;
        source: root.icon;
        colorize: Theme.text;
        opacity: root.dim;
    }
    Text {
        text: root.text;
        font-size: root.size * root.u;
        color: Theme.text;
        opacity: root.dim;
        vertical-alignment: center;
        overflow: elide;
    }
}

component NavMini inherits Rectangle {
    in property <length> u;
    property <length> divider-y: 532 * u;
    if !DashState.nav-active: Clock {
        u: root.u;
        x: (640 - 140) * root.u;
        y: (460 - 60) * root.u;
        width: 280 * root.u;
        height: 120 * root.u;
    }
    if DashState.nav-active: Rectangle {
        x: (640 - 140) * root.u;
        y: root.divider-y - top.preferred-height;
        width: 280 * root.u;
        height: top.preferred-height;
        top := VerticalLayout {
            padding-bottom: 13 * root.u;
            spacing: 13 * root.u;
            alignment: end;
            HorizontalLayout {
                alignment: center;
                Maneuver {
                    size: 84 * root.u;
                }
            }
            Text {
                text: DashState.nav-distance != "" ? DashState.nav-distance : DashState.nav-maneuver != "" ? DashState.nav-maneuver : "—";
                font-size: 22 * root.u;
                font-weight: 600;
                color: Theme.text;
                horizontal-alignment: center;
            }
        }
    }
    if DashState.nav-active: Rectangle {
        x: (640 - 140 * (DashState.nav-has-image ? 0.72 : 1)) * root.u;
        y: root.divider-y;
        width: 280 * root.u * (DashState.nav-has-image ? 0.72 : 1);
        height: max(1px, 1.4 * root.u);
        border-radius: self.height / 2;
        background: Theme.text-secondary;
        opacity: 0.35;
    }
    if DashState.nav-active: HorizontalLayout {
        x: (640 - 140) * root.u;
        y: root.divider-y + 13 * root.u;
        width: 280 * root.u;
        height: 30 * root.u;
        alignment: DashState.nav-has-image ? center : space-between;
        spacing: 18 * root.u;
        Fact {
            u: root.u;
            size: 20;
            icon: DashState.nav-time-left != "" ? @image-url("icons/AccessTime.svg") : @image-url("icons/Signpost.svg");
            text: DashState.nav-time-left != "" ? DashState.nav-time-left : DashState.nav-road != "" ? DashState.nav-road : "—";
        }
        if !DashState.nav-has-image: Fact {
            u: root.u;
            size: 22;
            icon: @image-url("icons/Route.svg");
            text: DashState.nav-destination-distance != "" ? DashState.nav-destination-distance : "—";
        }
    }
}

component NavFull inherits Rectangle {
    in property <length> u;
    property <length> divider-y: 532 * u;
    if !DashState.nav-active: Image {
        x: (640 - 42) * root.u;
        y: (460 - 42) * root.u;
        width: 84 * root.u;
        height: 84 * root.u;
        source: @image-url("icons/NavigationOutlined.svg");
        colorize: Theme.text;
        opacity: 0.55;
    }
    if DashState.nav-active: Rectangle {
        x: (640 - 460) * root.u;
        y: root.divider-y - block.preferred-height;
        width: 920 * root.u;
        height: block.preferred-height;
        block := HorizontalLayout {
            padding-bottom: 21 * root.u;
            spacing: 16 * root.u;
            alignment: center;
            VerticalLayout {
                alignment: end;
                spacing: 4 * root.u;
                HorizontalLayout {
                    alignment: center;
                    Maneuver {
                        size: 72 * root.u;
                    }
                }
                if DashState.nav-distance != "": Text {
                    text: DashState.nav-distance;
                    font-size: 20 * root.u;
                    font-weight: 600;
                    color: Theme.text;
                    horizontal-alignment: center;
                }
            }
            VerticalLayout {
                alignment: end;
                spacing: 6 * root.u;
                if DashState.nav-maneuver != "": Text {
                    text: DashState.nav-maneuver;
                    font-size: 24 * root.u;
                    color: Theme.text;
                    overflow: elide;
                }
                if DashState.nav-road != "" && !DashState.nav-has-image: Fact {
                    u: root.u;
                    size: 14;
                    dim: 0.85;
                    icon: @image-url("icons/Signpost.svg");
                    text: DashState.nav-road;
                }
                if DashState.nav-after-road != "" && !DashState.nav-has-image: Text {
                    text: DashState.nav-after-road;
                    font-size: 16 * root.u;
                    color: Theme.text;
                    overflow: elide;
                }
            }
        }
    }
    if DashState.nav-active: Rectangle {
        x: (640 - 300) * root.u;
        y: root.divider-y;
        width: 600 * root.u;
        height: max(1px, 1.4 * root.u);
        border-radius: self.height / 2;
        background: Theme.text-secondary;
        opacity: 0.35;
    }
    if DashState.nav-active: HorizontalLayout {
        x: (640 - 460) * root.u;
        y: root.divider-y + 21 * root.u;
        width: 920 * root.u;
        height: 26 * root.u;
        alignment: center;
        spacing: 24 * root.u;
        if DashState.nav-has-image && DashState.nav-road != "": Fact {
            u: root.u;
            size: 14;
            dim: 0.85;
            icon: @image-url("icons/Signpost.svg");
            text: DashState.nav-road;
        }
        if DashState.nav-time-left != "": Fact {
            u: root.u;
            size: 16;
            icon: @image-url("icons/AccessTime.svg");
            text: DashState.nav-time-left;
        }
        if DashState.nav-destination-distance != "": Fact {
            u: root.u;
            size: 16;
            icon: @image-url("icons/Route.svg");
            text: DashState.nav-destination-distance;
        }
        if DashState.nav-destination != "": Fact {
            u: root.u;
            size: 16;
            icon: @image-url("icons/Place.svg");
            text: DashState.nav-destination;
        }
        if DashState.nav-app != "": Fact {
            u: root.u;
            size: 14;
            dim: 0.85;
            icon: @image-url("icons/Apps.svg");
            text: DashState.nav-app;
        }
    }
}

component Dots inherits Rectangle {
    property <length> dot: clamp(Ui-height * 0.012, 6px, 10px);
    in property <length> Ui-height;
    height: dots.preferred-height;
    width: dots.preferred-width;
    border-radius: self.height / 2;
    background: Theme.dark ? #0000008c : #0000004d;
    dots := HorizontalLayout {
        padding: root.dot;
        spacing: root.dot;
        for i in DashState.page-count: Rectangle {
            width: root.dot * 2;
            height: root.dot * 2;
            Rectangle {
                width: root.dot;
                height: root.dot;
                border-radius: root.dot / 2;
                background: i == DashState.page-index ? Theme.primary : Theme.text-secondary;
                opacity: i == DashState.page-index ? 1 : 0.45;
            }
            TouchArea {
                clicked => { DashState.select-page(i); }
            }
        }
    }
}

export component Dashboard inherits Rectangle {
    property <float> s: min(root.width / 1280px, root.height / 720px);
    property <length> u: max(0.01, s) * 1px;
    property <length> left: (root.width - 1280 * u) / 2;
    property <length> top: (root.height - 720 * u) / 2;
    property <float> push: max(0, (root.width / u - 1280) / 2);
    property <color> pointer: DashState.has-accent ? DashState.accent : Theme.text;
    property <color> major: DashState.has-accent ? DashState.accent : Theme.text-secondary;
    property <color> shade: Theme.dark ? #0000008c : #ffffffb8;
    property <color> plate: Theme.dark ? #00000099 : #ffffffc7;
    property <bool> blinking: DashState.turn-left || DashState.turn-right || DashState.hazards;
    property <length> swipe-from;

    background: DashState.enabled && DashState.map ? transparent : Theme.background;

    Timer {
        interval: 500ms;
        running: root.blinking;
        triggered => { Blink.on = !Blink.on; }
    }

    if DashState.enabled && DashState.map: ViewAreaMask {
        mask: DashState.mask;
    }

    TouchArea {
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down) {
                root.swipe-from = self.mouse-x;
            } else if (e.kind == PointerEventKind.up) {
                let dx = self.mouse-x - root.swipe-from;
                if (abs(dx) >= 40px && DashState.page-count > 1) {
                    DashState.step(dx < 0 ? 1 : -1);
                }
            }
        }
    }

    if !DashState.enabled: Text {
        text: DashState.placeholder;
        color: Theme.text-secondary;
        font-size: 20px;
    }

    if DashState.enabled && DashState.gauges: Rectangle {
        Gauge {
            x: root.left + (-32 + DashState.ring-shift - root.push) * root.u;
            y: root.top + 60 * root.u;
            u: root.u;
            g: DashState.speed-gauge;
            value-t: DashState.speed-t;
            scale-color: Theme.text-disabled;
            major-color: root.major;
            pointer-color: root.pointer;
            backdrop: DashState.map;
            backdrop-color: root.shade;
        }
        Readout {
            x: round((root.left + (-32 + DashState.ring-shift - root.push + 235 + 34 - 100) * root.u) / 1phx) * 1phx;
            y: round((root.top + (60 + 300 - 65) * root.u) / 1phx) * 1phx;
            width: 200 * root.u;
            height: 130 * root.u;
            u: root.u;
            value: DashState.speed-text;
            caption: DashState.speed-label;
            to-end: true;
            backdrop: DashState.map;
            backdrop-color: root.plate;
        }
        Gauge {
            x: root.left + (850 + root.push - DashState.ring-shift) * root.u;
            y: root.top + 60 * root.u;
            u: root.u;
            g: DashState.rpm-gauge;
            value-t: DashState.rpm-t;
            scale-color: Theme.text-disabled;
            major-color: root.major;
            pointer-color: root.pointer;
            backdrop: DashState.map;
            backdrop-color: root.shade;
        }
        Readout {
            x: round((root.left + (850 + root.push - DashState.ring-shift + 235 - 34 - 100) * root.u) / 1phx) * 1phx;
            y: round((root.top + (60 + 300 - 65) * root.u) / 1phx) * 1phx;
            width: 200 * root.u;
            height: 130 * root.u;
            u: root.u;
            value: DashState.gear;
            caption: "GEAR";
            to-end: false;
            backdrop: DashState.map;
            backdrop-color: root.plate;
        }

        Lamp {
            x: root.left + 70 * root.u;
            y: root.top + 1 * root.u;
            width: 51 * root.u;
            height: 51 * root.u;
            source: @image-url("icons/PlayArrow.svg");
            transform-rotation: 180deg;
            tint: Signal.green;
            active: DashState.turn-left || DashState.hazards;
            blink: true;
        }
        Lamp {
            x: root.left + (1210 - 51) * root.u;
            y: root.top + 1 * root.u;
            width: 51 * root.u;
            height: 51 * root.u;
            source: @image-url("icons/PlayArrow.svg");
            tint: Signal.green;
            active: DashState.turn-right || DashState.hazards;
            blink: true;
        }
        HorizontalLayout {
            x: root.left + (640 - 2 * 30 - 1.5 * 21) * root.u;
            y: root.top + 12 * root.u;
            height: 30 * root.u;
            spacing: 21 * root.u;
            Lamp {
                width: 30 * root.u;
                source: @image-url("icons/TelltaleLowBeam.svg");
                tint: Signal.green;
                active: DashState.lights;
            }
            Lamp {
                width: 30 * root.u;
                source: @image-url("icons/TelltaleHighBeam.svg");
                tint: Signal.blue;
                active: DashState.high-beam;
            }
            Lamp {
                width: 30 * root.u;
                source: @image-url("icons/TelltaleHazard.svg");
                tint: Signal.red;
                active: DashState.hazards;
                blink: true;
            }
            Rectangle {
                width: 30 * root.u;
                opacity: DashState.parking-brake ? 1 : 0;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: @image-url("icons/TelltaleParkingRing.svg");
                    colorize: Signal.red;
                }
                Text {
                    text: "P";
                    font-size: 9.5 / 24 * 30 * root.u;
                    font-weight: 700;
                    color: Signal.red;
                }
            }
        }
        if DashState.ambient != "": Text {
            x: root.left + (1210 - 51 - 42) * root.u - self.width;
            y: root.top + 27 * root.u - self.height / 2;
            text: DashState.ambient;
            font-size: 20 * root.u;
            font-weight: 500;
            letter-spacing: 0.5 * root.u;
            color: Theme.text;
        }

        Level {
            x: root.left + 140 * root.u;
            y: root.top + 660 * root.u;
            height: 24 * root.u;
            u: root.u;
            icon: @image-url("icons/DeviceThermostat.svg");
            ratio: DashState.oil-ratio;
            value: DashState.oil-text;
            warn: DashState.oil-hot;
        }
        Level {
            x: root.left + 1140 * root.u - self.width;
            y: root.top + 660 * root.u;
            height: 24 * root.u;
            u: root.u;
            icon: DashState.battery ? @image-url("icons/BatteryHorizontal.svg") : @image-url("icons/LocalGasStation.svg");
            ratio: DashState.fuel / 100;
            value: DashState.fuel + "%";
            warn: DashState.fuel-low;
        }
    }

    if DashState.enabled && DashState.gauges && DashState.center == 1: NavMini {
        x: root.left;
        y: root.top;
        width: 1280 * root.u;
        height: 720 * root.u;
        u: root.u;
    }
    if DashState.enabled && DashState.gauges && DashState.center == 2: NavFull {
        x: root.left;
        y: root.top;
        width: 1280 * root.u;
        height: 720 * root.u;
        u: root.u;
    }

    if DashState.enabled && DashState.page-count > 1: Dots {
        Ui-height: root.height;
        x: (root.width - self.width) / 2;
        y: root.height - self.height - clamp(root.height * 0.022, 10px, 18px);
        opacity: DashState.dots-shown ? 1 : 0;
        animate opacity { duration: 220ms; }
    }
}
